# ==============================================================================
# PlantDex - Environment Configuration Template
# Copy this file to .env for local development:
#   copy .env.example .env     (Windows)
#   cp .env.example .env       (Linux/macOS)
# 
# IMPORTANT: Never commit your actual .env file or API keys to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Flask Security & Session Settings
# ------------------------------------------------------------------------------
# Secret key used for signing session cookies and CSRF tokens.
# Generate a strong 32+ character random key in production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secure-secret-key-32-chars

# Environment mode: 'production' or 'development'
FLASK_ENV=production

# ------------------------------------------------------------------------------
# Storage & Persistent Disk Paths (Render Hosting)
# ------------------------------------------------------------------------------
# On Render Free Tier: Leave commented out to use the default 'data/' folder.
# On Render Starter Tier with a Persistent Disk mounted at /var/data/plantdex:
# DATA_DIR=/var/data/plantdex

# ------------------------------------------------------------------------------
# Botanical Neural Engine & Confidence Thresholds
# ------------------------------------------------------------------------------
# >= 0.50 (50%): Specimen is CAUGHT and auto-saved to Pokédex with official Dex #
CONFIDENCE_CAUGHT=0.50

# 0.25 to 0.50 (25%-50%): Specimen is MAYBE; presents Top-3 species candidates to choose
CONFIDENCE_MAYBE=0.25

# < 0.25 (< 25%): Low confidence; prompts "Do you know this plant?" (Unknown N flow)

# Path to the AIY Plants V1 TFLite quantized classifier (auto-downloaded on server)
# MODEL_PATH=models/plants_v1.tflite

# Path to botanical labelmap CSV (2,102 classes)
# LABELS_PATH=data/aiy_plants_V1_labelmap.csv

# ------------------------------------------------------------------------------
# Optional Cloud Vision Second Opinion (Google Gemini Flash)
# ------------------------------------------------------------------------------
# If set, enables the "Double-check with Gemini" button on plant detail cards.
# If left empty, the app runs 100% offline using the local on-device AI model.
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Vision model identifier (e.g. gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Rate Limiting & Web Security
# ------------------------------------------------------------------------------
# Maximum login attempts allowed per minute per IP
RATE_LIMIT_LOGIN_MAX=10

# Maximum plant scan requests allowed per minute per IP
RATE_LIMIT_SCAN_MAX=30

# Polite scraper User-Agent header sent to Wikipedia and GBIF APIs
USER_AGENT=PlantDexApp/1.0 (Hacktoberfest Touch Grass Challenge; https://github.com/example/plantdex)
